VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Optional: AI chat proxy endpoint (never put a secret API key here).
# Deploy your own proxy that holds the AI provider key and forwards chat messages.
# The frontend only calls this endpoint; without it the assistant uses built-in help.
VITE_AI_CHAT_ENDPOINT=https://YOUR_PROXY/ai/chat
